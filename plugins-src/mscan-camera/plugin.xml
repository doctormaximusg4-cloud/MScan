<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="com.mintsog.mscan.camera" version="1.1.0">
  <name>MScanCamera</name>
  <js-module src="www/mscan-camera.js" name="MScanCamera"><clobbers target="MScanCamera"/></js-module>
  <platform name="android">
    <config-file target="AndroidManifest.xml" parent="/*">
      <uses-permission android:name="android.permission.CAMERA"/>
      <uses-feature android:name="android.hardware.camera" android:required="false"/>
    </config-file>
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="MScanCamera"><param name="android-package" value="com.mintsog.mscan.MScanCamera"/></feature>
    </config-file>
    <source-file src="src/android/MScanCamera.java" target-dir="app/src/main/java/com/mintsog/mscan"/>
  </platform>
</plugin>